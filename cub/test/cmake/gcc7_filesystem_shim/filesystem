// Minimal std::filesystem stand-in for GCC 7, which does not ship
// <filesystem> (it arrived in GCC 8). This header shadows the standard
// header for the rapids-cmake resource-spec detector only, providing
// exactly what that tool uses: std::filesystem::current_path().string().
// POSIX-only by design. Remove when GCC 7 support is dropped.

#pragma once

#include <string>

#include <unistd.h>

namespace std
{
namespace filesystem
{

class path
{
public:
  explicit path(std::string value)
      : value_(static_cast<std::string&&>(value))
  {}

  const std::string& string() const
  {
    return value_;
  }

private:
  std::string value_;
};

inline path current_path()
{
  char buf[4096];
  return path(::getcwd(buf, sizeof(buf)) ? std::string(buf) : std::string());
}

} // namespace filesystem
} // namespace std
